--- /dev/null
+++ b/target/linux/ipq40xx/files/arch/arm/boot/dts/qcom-ipq4019-hooolink-hl-wr832.dts
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later OR MIT */
+/* Hooolink HL-WR832 - board-specific definition from OEM documentation and board dump. */
+
+/dts-v1/;
+#include "qcom-ipq4019.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Hooolink HL-WR832";
+	compatible = "hooolink,hl-wr832", "qcom,ipq4019";
+
+	memory {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>; /* OEM: 512 MB RAM Layout */
+	};
+
+	soc {
+		pinmux@1000000 {
+			serial_pins: serial_pins {
+				mux {
+					pins = "gpio16", "gpio17";
+					function = "blsp_uart0";
+					drive-strength = <8>;
+					bias-disable;
+				};
+			};
+
+			spi_0_pins: spi_0_pins {
+				mux {
+					pins = "gpio12", "gpio13", "gpio14", "gpio15";
+					function = "blsp_spi0";
+					drive-strength = <12>;
+					bias-disable;
+				};
+			};
+
+			nand_pins: nand_pins {
+				mux {
+					pins = "gpio53", "gpio55", "gpio56", "gpio57", "gpio58",
+					       "gpio59", "gpio60", "gpio62", "gpio63", "gpio64",
+					       "gpio65", "gpio66", "gpio67", "gpio68", "gpio69";
+					function = "qpic";
+					drive-strength = <12>;
+					bias-disable;
+				};
+			};
+		};
+
+		leds {
+			compatible = "gpio-leds";
+
+			system {
+				label = "green:system";
+				gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
+			};
+
+			wlan2g {
+				label = "green:wlan2g";
+				gpios = <&tlmm 1 GPIO_ACTIVE_LOW>;
+			};
+
+			wlan5g {
+				label = "green:wlan5g";
+				gpios = <&tlmm 2 GPIO_ACTIVE_LOW>;
+			};
+
+			usb3 {
+				label = "green:usb3";
+				gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
+			};
+
+			internet {
+				label = "green:internet";
+				gpios = <&tlmm 4 GPIO_ACTIVE_LOW>;
+			};
+		};
+
+		keys {
+			compatible = "gpio-keys";
+
+			restart {
+				label = "restart";
+				gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
+				linux,code = <KEY_RESTART>;
+			};
+		};
+
+		/* 5G M.2 Modem Slot Power Enablers based on OEM schematics */
+		gpio-export {
+			compatible = "gpio-export";
+			#size-cells = <0>;
+			lte_pwr_sw { gpio-export,name = "lte_pwr_sw"; gpio-export,output = <1>; gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en1 { gpio-export,name = "lte_pwr_en1"; gpio-export,output = <1>; gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en2 { gpio-export,name = "lte_pwr_en2"; gpio-export,output = <1>; gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en3 { gpio-export,name = "lte_pwr_en3"; gpio-export,output = <1>; gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en4 { gpio-export,name = "lte_pwr_en4"; gpio-export,output = <1>; gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en5 { gpio-export,name = "lte_pwr_en5"; gpio-export,output = <1>; gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en6 { gpio-export,name = "lte_pwr_en6"; gpio-export,output = <1>; gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_en7 { gpio-export,name = "lte_pwr_en7"; gpio-export,output = <1>; gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>; };
+			lte_pwr_hub { gpio-export,name = "lte_pwr_hub"; gpio-export,output = <1>; gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>; };
+		};
+	};
+};
+
+&blsp1_uart1 {
+	pinctrl-0 = <&serial_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&blsp1_spi0 {
+	pinctrl-0 = <&spi_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+	cs-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+
+	flash@0 {
+		reg = <0>;
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <24000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x000000 0x040000>;
+				read-only;
+			};
+			partition@40000 {
+				label = "0:MIBIB";
+				reg = <0x040000 0x020000>;
+				read-only;
+			};
+			partition@60000 {
+				label = "0:QSEE";
+				reg = <0x060000 0x060000>;
+				read-only;
+			};
+			partition@c0000 {
+				label = "0:CDT";
+				reg = <0x0c0000 0x010000>;
+				read-only;
+			};
+			partition@d0000 {
+				label = "0:DDRPARAMS";
+				reg = <0x0d0000 0x010000>;
+				read-only;
+			};
+			partition@e0000 {
+				label = "0:APPSBLENV";
+				reg = <0x0e0000 0x010000>;
+				read-only;
+			};
+			partition@f0000 {
+				label = "0:APPSBL";
+				reg = <0x0f0000 0x080000>;
+				read-only;
+			};
+			partition@170000 {
+				label = "0:ART";
+				reg = <0x170000 0x010000>;
+				read-only;
+
+				compatible = "nvmem-cells";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				precal_art_1000: precal@1000 {
+					reg = <0x1000 0x2f20>;
+				};
+
+				precal_art_5000: precal@5000 {
+					reg = <0x5000 0x2f20>;
+				};
+
+				macaddr_gmac0: macaddr@0 {
+					reg = <0x0 0x6>;
+				};
+
+				macaddr_gmac1: macaddr@6 {
+					reg = <0x6 0x6>;
+				};
+			};
+		};
+	};
+};
+
+&nand {
+	pinctrl-0 = <&nand_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	nand@0 {
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "ubi";
+				reg = <0x00000000 0x04000000>; /* 1G Flash / 64 MiB UBI Layout */
+			};
+		};
+	};
+};
+
+&wifi0 {
+	status = "okay";
+	nvmem-cell-names = "pre-calibration";
+	nvmem-cells = <&precal_art_1000>;
+	qcom,ath10k-calibration-variant = "Hooolink-HL-WR832";
+};
+
+&wifi1 {
+	status = "okay";
+	nvmem-cell-names = "pre-calibration";
+	nvmem-cells = <&precal_art_5000>;
+	qcom,ath10k-calibration-variant = "Hooolink-HL-WR832";
+};
+
+&gmac { status = "okay"; };
+&switch { status = "okay"; };
+&swport1 { status = "okay"; label = "lan1"; };
+&swport2 { status = "okay"; label = "lan2"; };
+&swport3 { status = "okay"; label = "lan3"; };
+&swport4 { status = "okay"; label = "lan4"; };
+&swport5 { status = "okay"; label = "wan"; };
